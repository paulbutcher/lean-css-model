/-! The argument grammar of each function variant, generated by `gen`. -/

namespace CssModel

namespace FuncSyntax

def linear : Vds :=
  .commaList (.allOf [
    .atom { number := some .all },
    .rep 0 2 (.atom { percentage := some .all })])

def cubicBezier : Vds :=
  .commaRep 2 2 (.seq [
    .atom { number := some { lo := some 0, hi := some 1 } },
    .atom Sym.comma,
    .atom { number := some .all }])

def steps : Vds :=
  .seq [
    .atom { integer := some .all },
    .opt (.seq [.atom Sym.comma, .nonEmpty (.opt (.atom Atoms.stepPosition))])]

def scroll : Vds :=
  .opt (.someOf [.atom Atoms.scroller, .atom Atoms.axis])

def view : Vds :=
  .opt (.someOf [
    .atom Atoms.axis,
    .commaList (.rep 1 2 (.atom { keywords := Sym.keywordSet [.auto], length := some .all, percentage := some .all }))])

