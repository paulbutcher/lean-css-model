      .atom { keywords := Sym.keywordSet [.any, .center, .inlineEnd, .inlineStart, .spanAll, .spanInlineEnd, .spanInlineStart] }],
    .someOf [
      .atom { keywords := Sym.keywordSet [.any, .center, .selfBlockEnd, .selfBlockStart, .spanAll, .spanSelfBlockEnd, .spanSelfBlockStart] },
      .atom { keywords := Sym.keywordSet [.any, .center, .selfInlineEnd, .selfInlineStart, .spanAll, .spanSelfInlineEnd, .spanSelfInlineStart] }],
    .rep 1 2 (.atom { keywords := Sym.keywordSet [.any, .center, .«end», .spanAll, .spanEnd, .spanStart, .start] }),
    .rep 1 2 (.atom { keywords := Sym.keywordSet [.any, .center, .selfEnd, .selfStart, .spanAll, .spanSelfEnd, .spanSelfStart] })]

def height : Vds :=
  .atom { length := some .all }

def inlineSize : Vds :=
  .atom { length := some .all }

def orientation : Vds :=
  .atom { keywords := Sym.keywordSet [.landscape, .portrait] }

def scrollable : Vds :=
  .atom { keywords := Sym.keywordSet [.block, .blockEnd, .blockStart, .bottom, .inline, .inlineEnd, .inlineStart, .left, .none, .right, .top, .x, .y] }

def scrolled : Vds :=
  .atom { keywords := Sym.keywordSet [.block, .blockEnd, .blockStart, .bottom, .inline, .inlineEnd, .inlineStart, .left, .none, .right, .top, .x, .y] }

def snapped : Vds :=
  .atom { keywords := Sym.keywordSet [.block, .both, .inline, .none, .x, .y] }

def stuck : Vds :=
  .atom { keywords := Sym.keywordSet [.blockEnd, .blockStart, .bottom, .inlineEnd, .inlineStart, .left, .none, .right, .top] }

def width : Vds :=
