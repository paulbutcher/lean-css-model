  id : Nat
  valid : id < 3
  deriving DecidableEq, Repr

namespace ColorProfileDescriptor

/-- `components` -/
def components : ColorProfileDescriptor := ⟨0, by decide⟩
/-- `rendering-intent` -/
def renderingIntent : ColorProfileDescriptor := ⟨1, by decide⟩
/-- `src` -/
def src : ColorProfileDescriptor := ⟨2, by decide⟩

def names : Array String := #[
  "components",
  "rendering-intent",
  "src"]

def name (x : ColorProfileDescriptor) : String := names[x.id]?.getD ""

def ofName? (s : String) : Option ColorProfileDescriptor :=
  match names.findIdx? (· == s) with
  | .some i => if h : i < 3 then .some ⟨i, h⟩ else .none
  | .none => .none

end ColorProfileDescriptor

namespace ColorProfileDescriptorSyntax

def components : Vds :=
  .commaList (.atom { keywords := Keyword.allBits, simple := Sym.simpleSet [.dashedIdent], customIdent := some Exclusion.colorProfileComponents })

def renderingIntent : Vds :=
  .atom { keywords := Sym.keywordSet [.absoluteColorimetric, .perceptual, .relativeColorimetric, .saturation] }

def src : Vds :=
  .atom { simple := Sym.simpleSet [.url] }

end ColorProfileDescriptorSyntax

def ColorProfileDescriptor.syntaxAt (i : Nat) : Vds :=
  if i < 1 then
    ColorProfileDescriptorSyntax.components
  else
    if i < 2 then
      ColorProfileDescriptorSyntax.renderingIntent
    else
      ColorProfileDescriptorSyntax.src

def ColorProfileDescriptor.syntax (x : ColorProfileDescriptor) : Vds := ColorProfileDescriptor.syntaxAt x.id

