  .oneOf [
    .atom { keywords := Sym.keywordSet [.none] },
    .someOf [
      .atom { simple := Sym.simpleSet [.dashedIdent] },
      .someOf [
        .atom { keywords := Sym.keywordSet [.flipBlock] },
        .atom { keywords := Sym.keywordSet [.flipInline] },
        .atom { keywords := Sym.keywordSet [.flipStart] },
        .atom { keywords := Sym.keywordSet [.flipX] },
